import numpy as np

X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])

y = np.array([0, 1, 1, 1])


def train(learning_rate):

    weights = np.array([0.3, 0.1], dtype=float)
    bias = 0

    for epoch in range(1, 101):

        total_error = 0

        for i in range(len(X)):

            net = np.dot(X[i], weights) + bias
            output = 1 if net >= 0 else 0

            error = y[i] - output
            total_error += abs(error)

            weights += learning_rate * error * X[i]
            bias += learning_rate * error

        if total_error == 0:
            break

    predictions = []

    for x in X:
        net = np.dot(x, weights) + bias
        predictions.append(1 if net >= 0 else 0)

    accuracy = np.mean(np.array(predictions) == y) * 100

    return epoch, weights, bias, accuracy


for lr in [0.1, 0.5, 1.0]:

    epochs, weights, bias, accuracy = train(lr)

    print("\nLearning Rate:", lr)
    print("Epochs:", epochs)
    print("Final Weights:", weights)
    print("Final Bias:", bias)
    print("Accuracy:", accuracy, "%")
