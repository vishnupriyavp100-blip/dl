import numpy as np

def step_function(x):
    return 1 if x > 0 else 0


X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])


def test_gate(name, weights, bias):
    print("\n", name)
    print("X1\tX2\tOutput")

    for x in X:
        net = np.dot(x, weights) + bias
        output = step_function(net)
        print(x[0], "\t", x[1], "\t", output)


test_gate("AND", [1, 1], -0.5)
test_gate("OR", [1, 1], -0.5)
test_gate("NAND", [-1, -1], 1.5)
