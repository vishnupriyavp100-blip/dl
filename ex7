import numpy as np

X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])

y = np.array([0, 1, 1, 1])

learning_rate = 0.2

for total_epochs in [5, 10, 20]:

    weights = np.array([0.3, 0.1], dtype=float)
    bias = 0

    print("\nTraining for", total_epochs, "epochs")

    for epoch in range(1, total_epochs + 1):

        total_error = 0

        for i in range(len(X)):

            net = np.dot(X[i], weights) + bias
            output = 1 if net >= 0 else 0

            error = y[i] - output
            total_error += abs(error)

            weights += learning_rate * error * X[i]
            bias += learning_rate * error

        print("Epoch:", epoch, "Total Error:", total_error)

        if total_error == 0:
            print("Perceptron converged at epoch", epoch)
            break
