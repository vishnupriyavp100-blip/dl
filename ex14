import numpy as np
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense
from sklearn.model_selection import train_test_split
from sklearn.datasets import make_moons

np.random.seed(42)
tf.random.set_seed(42)

X, Y = make_moons(
    n_samples=1000,
    noise=0.2,
    random_state=42
)

X_train, X_val, Y_train, Y_val = train_test_split(
    X, Y,
    test_size=0.2,
    random_state=42
)


# Model 1: One hidden layer
model1 = Sequential([
    Dense(8, input_dim=2, activation='relu'),
    Dense(1, activation='sigmoid')
])

model1.compile(
    optimizer='adam',
    loss='binary_crossentropy',
    metrics=['accuracy']
)

model1.fit(
    X_train,
    Y_train,
    epochs=100,
    verbose=0
)

loss1, acc1 = model1.evaluate(
    X_val,
    Y_val,
    verbose=0
)


# Model 2: Two hidden layers
model2 = Sequential([
    Dense(8, input_dim=2, activation='relu'),
    Dense(8, activation='relu'),
    Dense(1, activation='sigmoid')
])

model2.compile(
    optimizer='adam',
    loss='binary_crossentropy',
    metrics=['accuracy']
)

model2.fit(
    X_train,
    Y_train,
    epochs=100,
    verbose=0
)

loss2, acc2 = model2.evaluate(
    X_val,
    Y_val,
    verbose=0
)


print("ONE HIDDEN LAYER")
print("Accuracy:", acc1)
print("Loss:", loss1)

print("\nTWO HIDDEN LAYERS")
print("Accuracy:", acc2)
print("Loss:", loss2)
